NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
AI_PROVIDER=nebius
NEBIUS_API_KEY=server-only-nebius-token-factory-key
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
# Optional overrides only. Token Factory vision uses NEBIUS_API_KEY and
# NEBIUS_BASE_URL unless these are explicitly set. Models below passed live tests.
NEBIUS_VISION_API_KEY=
NEBIUS_VISION_BASE_URL=
NEBIUS_VISION_MODEL=openbmb/MiniCPM-V-4_5
# Explicit transcription endpoint supporting Chinese (no Parakeet default).
NEBIUS_AUDIO_API_KEY=
NEBIUS_AUDIO_BASE_URL=
NEBIUS_AUDIO_MODEL=
NEBIUS_AUDIO_MODE=transcriptions
AI_IMPORT_ENABLED=false
AI_DAILY_USER_LIMIT=3
AI_DAILY_GLOBAL_LIMIT=30
AI_IMPORT_TTL_HOURS=24
CRON_SECRET=server-only-cron-secret
APP_ORIGIN=http://localhost:5173
CALENDAR_TOKEN_ENCRYPTION_KEY=base64url-encoded-32-byte-server-only-key
GOOGLE_CALENDAR_CLIENT_ID=google-oauth-client-id
GOOGLE_CALENDAR_CLIENT_SECRET=google-oauth-client-secret
MICROSOFT_CALENDAR_CLIENT_ID=microsoft-entra-application-client-id
MICROSOFT_CALENDAR_CLIENT_SECRET=microsoft-entra-client-secret
MICROSOFT_CALENDAR_TENANT_ID=common
